# Local credentials — never commit (includes backups/copies of conf.env)
conf.env*
!conf.env.example
.env

# Python
__pycache__/
*.py[cod]

# Virtual environment (created by auto_setup.py)
venv/

# Debug output (raw eClass/CAS pages)
cas_debug.html
announce_debug.json

# Runtime state of one install: what has already been notified, the last scan
# and the scan lock. Each install builds its own (the first scan records a
# baseline without alerts); a copy of someone else's would defeat that.
General_Items/*.json
General_Items/*.json.tmp
General_Items/.scan.lock

# Per-day run logs (logs/YYYY-MM-DD.log) and the legacy single log
logs/
cron.log

# Generated CA bundle and temp files (build locally with bash install-certs.sh)
certs/

# Internal audit reports (regenerated by each audit round)
tests/FINDINGS.md
tests/VERIFY.md
tests/LOG.md

# Windows
Thumbs.db
desktop.ini
