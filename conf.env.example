# Copy this file to `conf.env` and fill in your real values.
# `conf.env` is git-ignored so your credentials never get committed.
# Wrap a value in double quotes if it starts or ends with a space or a quote
# character, e.g. ECLASS_PASS="pa55word'". If a key appears twice, the later
# line wins.

# eClass / CAS login
ECLASS_USER=your_username
ECLASS_PASS=your_password

# Where notifications go: `telegram` or `discord`.
# Only the settings for the platform you pick are required.
NOTIFY_PLATFORM=telegram

# Scan every N hours at fixed clock times (1, 2, 3, 4, 6, 8, 12 or 24), e.g.
# 6 = 00:00, 06:00, 12:00, 18:00. Scans missed while the machine was off or
# asleep are caught up when it's back. Chat commands (/scan-uni, /create-cert,
# /status, /help) work any time.
SCAN_INTERVAL_HOURS=6

# Telegram bot (NOTIFY_PLATFORM=telegram)
TG_TOKEN=123456789:your_telegram_bot_token
TG_CHAT=your_telegram_chat_id

# Discord bot (NOTIFY_PLATFORM=discord) - easiest set up with auto_setup.py.
# Token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
# Channel ID: Discord settings -> Advanced -> Developer Mode, then right-click
# the channel -> Copy Channel ID. The bot must be in that server and allowed
# to View Channel + Send Messages there.
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=123456789012345678
